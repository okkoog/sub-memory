 {
  "method": "System.String MidnightPawn.ModSettings/<>c::<Define>b__18_1()",
  "token": "0600024B",
  "index": 0,
  "offset": 0,
  "source": "拾荒抓苗床的基准线。周末、垃圾场事件、连续空手会在它上面加成；手里苗床越多越难抓到。",
  "action": "patch",
  "target": "폐품 수집 중 묘상을 포획할 확률의 기준선입니다. 주말, 쓰레기장 이벤트, 연속 빈손 횟수에 따라 보너스가 붙으며 보유 묘상이 많을수록 포획하기 어려워집니다.",
  "reason": "reviewed display or diagnostic callsite"
 },
 {
