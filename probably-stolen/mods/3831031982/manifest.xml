<?xml version="1.0" encoding="utf-8"?>
<!--
  Korean language pack for the Language Framework (elio.langcore).
  - Code ko-KR: the game reserves "ko" (empty slot with Korean fonts); fontBranch "ko" selects those fonts.
  - The DLL is an empty IMod shell (required by the ModLoader); it does not reference the core.
  - Translations live in lang/ (not part of the mod fingerprint: editing them needs no re-approval).
  - Prerequisites are informational: the core finds this pack by its lang/pack.json, whatever the load order.
-->
<ModManifest>
  <ID>elio.lang.ko-KR</ID>
  <Name>한국어 (Korean)</Name>
  <Author>Elio</Author>
  <ModVersion>1.1.5</ModVersion>
  <Description>Korean fan translation. Requires the "Language Framework" mod (elio.langcore). / 한국어 팬 번역입니다. "Language Framework" 모드가 필요합니다.</Description>

  <GameVersions>
    <Version>0.46D</Version>
  </GameVersions>

  <Prerequisites>
    <Mod>elio.langcore</Mod>
  </Prerequisites>

  <Assemblies>
    <Assembly>LangPack.ko-KR.dll</Assembly>
  </Assemblies>

  <Capabilities />
</ModManifest>
