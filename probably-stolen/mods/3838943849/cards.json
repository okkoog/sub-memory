{
  // ════════════════════════════════════════════════════════════════
  //  深空抽卡 MOD · 全部可调项都在这一个文件里
  //  改完在游戏里按 F9 →「抽卡」→「重载卡池（cards.json）」即可生效
  //  这个解析器允许 // 注释、/* */ 注释、末尾多逗号、UTF-8 BOM，
  //  用记事本随便改都不容易坏；真写错了日志里会告诉你第几行第几列。
  // ════════════════════════════════════════════════════════════════

  // ── 1. 数值 ──────────────────────────────────────────────────────
  "balance": {
    "pullPrice": 160,          // 单抽价格（商人卖券的原价，一叠 10 张就是 1600）
    "dailyTickets": 15,        // 商人每次到店卖多少张（游戏内设置面板 10~50 可调），卖不完的换日就收走
    "stackSize": 10,           // 券每叠上限
    // 下面四项在「模组菜单 → 齿轮 → 抽卡概率」里也能调，且面板里的值优先；
    // 面板里四个数加起来不等于 100 也没关系，游戏按总和折算。
    "pN": 0.58,                // N 档概率 58%
    "pR": 0.345,               // R 档概率 34.5%
    "pSR": 0.06,               // SR 档概率 6%（剩 1.5% 是 UR）
    "pityUR": 90,              // UR 硬保底抽数
    "merchantFirstDay": 2,     // 商人从第几天开始来（1 = 第一天就来）
    "merchantVisitGap": 3,     // 商人每隔几天来一次（1 = 天天来，默认 3 → 第 2/5/8… 天）
    "codezGiftTickets": 10,    // 初见见面礼：第一次到店往后仓放几张券（10 = 一叠十连，上限 99）
    // 抽卡商人兼卖的「侵蚀抑制剂」：每次到店在柜台上摆几根（含端点，每次随机）
    "suppressorMin": 3,
    "suppressorMax": 5,
    "suppressorPrice": 100,    // 柜台单价（0 = 用物品自己的面值 100）
    "wholesaleDiscount": 10,   // 「接受批发」折扣百分比（正数=便宜多少），0 = 不打折，10 = 九折 2400→2160
    "phonePrice": 300,         // 小手机（Fairy 同款二手智能手机）的售价
    "printerPrice": 10000,     // 离线印卷机的售价（商人处 10% 概率刷一台，可以买多台）
    "printerChance": 10,       // 商人每天上架印卷机的概率（百分比，0 = 永不刷）
    "printerExchangePrice": 160, // 印卷机上点一次「兑换」扣多少信用点
    "printerDailyExchange": 10,  // 每台机器每日兑换上限（次日刷新，不累计）
    "printerProduceCap": 10,     // 生产区最多叠几张，满了当天停产，拿走后才继续

    // 灯牌本身的价格（哲/铃 的出现概率在下面 §1.7 的 clientGroups 里）
    "duoLampPrice": 200,       // 「兄妹诱捕器」灯牌的售价（商人处只卖一块：手上有了就不再上架）

    // MOD 顾客立绘在场景里站多高（单位≈一个物品格）。0 = 自动对齐原版顾客，
    // 一般不用改。个别顾客想单独调，就在 §1.7 的 clients 里写 "portraitHeight"。
    "clientArtHeight": 0,

    // ── 立绘的缩放 / 位置（三个数字就是「立绘修改器」里那三个滑条）──
    //   clientArtScale    缩放，百分比。100 = 基准大小，220 = 放大到 2.2 倍
    //   clientArtOffsetX  左右偏移，百分比。正值向右，-2 = 往左挪立绘宽度的 2%
    //   clientArtOffsetY  上下偏移，百分比。正值向上，-50 = 往下挪立绘高度的 50%
    // 单个顾客想不一样，就在 §1.7 的 clients 里写 portraitScale / portraitOffsetX / portraitOffsetY
    "clientArtScale": 220,
    "clientArtOffsetX": -2,
    "clientArtOffsetY": -23
  },

  // ── 1.5 手机里的限时委托（P1）────────────────────────────────────
  //  "目标卡牌" 从下面的 ur / sr 里随机抽，出价 = 卡牌 value × priceRate（固定价格）
  //  每条委托单独算期限（1~5 个游戏日，睡一觉 = 过一天）
  //  交付成功 → 那条第二天换新；到期没交 → 那条立刻换新，其它条不受影响
  //  手机顶上的「信号 X/Y」= 还没交付的条数 / 总条数
  "orders": {
    "count": 5,                // 同时挂几条（改这里信号分母也跟着变）
    "minDays": 1,              // 最短期限（天）
    "maxDays": 5,              // 最长期限（天）
    "priceRate": 1.0,          // 出价倍率：1.0 = 按卡牌面值；1.2 = 加价两成
    "tiers": [ "SR", "UR" ],   // 从哪些档位抽
    "pool": []                 // 只出这几张卡（写卡池 id）；留空 = 按 tiers 抽整个池
  },

  // ════════════════════════════════════════════════════════════════
  //  1.7 MOD 专属顾客（新人就照抄一条下来改，见文件末尾的模板）
  //  ────────────────────────────────────────────────────────────────
  //  clients 一条 = 一个人，只有 6 样东西要填：
  //    id          必填，自己起（别跟原版重名，建议 ds_ 开头）
  //    name        必填，对话框上显示的名字
  //    portrait    立绘：Mods\ds_gacha\Art\<这个名字>.png（不带扩展名）
  //    budgetMin / budgetMax   身上带的信用点（进场时在区间里随机）
  //    buys        「感兴趣的商品」——写**标签**，卡片上的 kind / 档位 / tags 都算
  //    lines       说话内容，一行一句按顺序念；{budget} {name} {tags} 会自动替换
  //
  //  另外几个都是可选的：
  //    pickTags    每次来随机挑几个标签（默认 2 = 每次随机挑 1~2 个，下次来重新挑）
  //    multiplier  出售加成（原版交易面板顶上那行「卖出 x1.00」）：
  //                1.0 = 原版标准，2.0 = 双倍声望，0 = 白送（0 会被当成 1，别写 0）
  //    group       归到下面哪一组；不写 = 自己单独一组，用自己身上的 chance 掷骰
  //    chance      只有单独一组时才有意义：每天出现的概率（%）
  //    faction     阵营，默认 FACTION_LOWER_LEVEL
  //    bargain     能不能还价（默认 false；具体规则在下面 1.8 的 "bargain" 段改）
  //    portraitHeight  这个人的立绘站多高（单位≈物品格，0/不写 = 自动对齐原版顾客）
  //                    图比原版大得离谱、糊满屏幕时填 2 ~ 2.5 左右
  //    portraitScale   这个人的立绘缩放（%，不写 = 用 balance.clientArtScale）
  //    portraitOffsetX 这个人的左右偏移（%，正值向右，不写 = 用 balance.clientArtOffsetX）
  //    portraitOffsetY 这个人的上下偏移（%，正值向上，不写 = 用 balance.clientArtOffsetY）
  //
  //  clientGroups 一条 = 一次骰子：掷中了就从这组里随机挑 N 位一起进店。
  //    chance            每天出现的概率（%）
  //    lampId            认哪块灯牌（物品 id）；留空 = 这组不吃灯牌加成
  //    lampChance        展示柜摆着那块灯牌时的概率（%）；-1 = 不变
  //    countMin/countMax 没灯牌时来几位
  //    lampCountMin/lampCountMax  有灯牌时来几位
  // ════════════════════════════════════════════════════════════════
  "clientGroups": [
    {
      "id": "duo",
      "chance": 10,              // 展示柜没灯牌：每天 10%
      "lampId": "ds_duo_lamp",   // 认「兄妹诱捕器」
      "lampChance": 50,          // 灯牌摆在展示柜里：每天 50%
      "countMin": 1, "countMax": 1,        // 没灯牌只来 1 位
      "lampCountMin": 1, "lampCountMax": 2 // 有灯牌来 1~2 位（两位一起来是常态）
    }
    // 单人示例（想让某个人单独出现，就在这里加一条，然后他的 client 上写 "group": "单人组的id"）：
    // { "id": "solo_demo", "chance": 5, "lampChance": -1, "countMin": 1, "countMax": 1 }
  ],

  // ════════════════════════════════════════════════════════════════
  //  1.8 强买强卖 · 议价（只对上面 clients 里的人 + 只对「代理人」卡）
  //  ────────────────────────────────────────────────────────────────
  //  tag          只对带这个标签的卡生效（改这里 = 换成一整类别的卡）
  //  prefMin/Max  每次到店，对**每一张**代理人卡各掷一次倍率，落在 0.7 ~ 1.3 之间，
  //               那张卡卖给他的价格就乘这个倍率（交易面板上显示的就是乘过的价）。
  //               同一趟里反复开窗口、来回拖卡，倍率都不会变；换一天 / 换个人重新掷。
  //  tryPercent   试探性还价：要对方加多少 %
  //  tryChance    答应了概率（%）；不答应就反过来压价 tryPercent %
  //  greedyPercent 狮子大开口：要对方加多少 %
  //  greedyChance 答应了概率（%）；不答应他扭头就走，这单没了
  //  每人每天只有一次议价机会（不管成没成）。
  //  playerLines  玩家自己的台词（见好就收 / 试探性还价 / 狮子大开口），
  //               每条写一句，点按钮时随机抽一句；哲和铃共用这一套。
  //               占位符：{price} 当前报价 · {name} 卡名 · {client} 顾客名
  // ════════════════════════════════════════════════════════════════
  "bargain": {
    "tag": "代理人",
    "prefMin": 0.7,
    "prefMax": 1.3,
    "tryPercent": 15,
    "tryChance": 40,
    "greedyPercent": 30,
    "greedyChance": 20,
    "playerLines": {
      "accept": [
        "行，就这个价，成交。",
        "……算了，卖你了。",
        "数钱吧，卡归你。"
      ],
      "tryMore": [
        "这卡成色这么好，再加点吧。",
        "差点意思，往上抬一抬？",
        "别急着走啊，价钱还能再谈谈。"
      ],
      "greedy": [
        "这可是限定货，翻个价不过分吧？",
        "你识货的，这个价已经很便宜了。",
        "我这卡全城就这一张，你确定不再加点？"
      ]
    }
  },

