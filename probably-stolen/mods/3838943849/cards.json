  // ── 3. UP 候选名单（★多卡池版本起已废弃，不必再维护）──────────────
  //  UP 名单现在跟着「池」走，写在 pools.json 每个池自己的 upOrder 里：
  //  留空 = 本池全部 UR 随机轮换（常驻池就是这么用的，永远留空）。
  //  这一段留着只为一件事：0.3.3 及更早的老存档迁移时按序号找回当期 UP。
  //  新存档完全不看它 —— 整段删掉也没影响（删了会自动当成「全部 UR」）。
  "upOrder": [ "ellen", "zhuyuan", "qingyi", "jian", "Robin", "Kafka", "ailisi", "yifulin", "yaojiayin", "banji", "fuboyouye", "xide", "yuguo", "xingjianya", "yixuan", "weiweian", "gelisi", "keleida", "lina", "11hao", "maoyou", "kaisa", "bonisi", "liu", "laite", "youzhen", "jufufu", "aofeisi", "lycaon" ],

  // ── 3.5 UP 冷却（一张卡当过 UP 之后，要空过几轮才会重新进随机池）──
  //  1 轮 = 7 天。默认 3：当过一次之后要再隔 3 轮（21 天）才可能被抽到，
  //  避免「简·杜 → 知更鸟 → 简·杜」这种刚走又回来的体感。
  //  写 0 就是关掉冷却（老行为）；名单太短（UR 不足 4 张）时冷却会被自动放宽。
  "upCooldown": 3,

  // ── 4. 卡片 ──────────────────────────────────────────────────────
  //  每个字段：
  //    id          必填，英文小写，物品 id 会变成 ds_card_<id>
  //    name        卡名（游戏里显示的名字）
  //    value       面值（信用点）
  //    w / h       物品栏里占几格（1 格 = 16px）。不写 = 2 × 3（代理人卡）
  //                贴图要跟格数对上：占 w×h 格就该是 w*16 × h*16 的 PNG，
  //                否则格子里的图会溢出（2×2 → 32×32，2×3 → 32×48）
  //    sprite      格子里的卡面：Textures/Items/<名字>.png，不带扩展名；不写 = 通用档位卡背
  //                （只是格子用的小图，放大了必然糊）
  //    art         双击 / 放大镜查看时显示的高清大图：Art/<名字>.png，尺寸随意
  //                不写就跟 sprite 同名；找不到会自动退回格子里那张小图
  //    desc        物品描述
  //    type        物品类型 / 主标签，不写默认 "ZZZ"（以前写死 LUXURY_ITEM 奢侈品）
  //    kind        ★ 这张卡是哪一类：代理人 / 音擎 / 邦布 …… 你自己起
  //                它会自动变成一条标签，顾客的 buys 直接写这一类就行（最好用的一个字段）
  //    faction     阵营，**只有代理人卡写**：狡兔屋 / 维多利亚家政 / 卡吕冬之子 / 刑侦特勤组 …
  //                派遣委托的 restrictions.faction 就是拿它比对的（要求**全称完全一致**）。
  //                不写会退回从 desc 的「X 级代理人卡，<阵营>。」里抠，但建议补上，改文案才不失效。
  //    tags        额外的自由标签，数组。比如 [ "限定", "绝版" ]
  //    inspectable 能不能用放大镜拖上来放大看，默认 true
  //
  //  ★ 每张卡最终带的标签（顾客「感兴趣的商品」能写的就是这些）：
  //      ZZZ                  永远都有 —— 本 mod 的所有卡都算 ZZZ 这一族
  //      SR / UR              永远都有 —— 档位
  //      kind 里写的那个       写了才有 —— 代理人 / 音擎 / 邦布 …
  //      tags 里写的那些       写了才有 —— 随便起
  //    举例：下面那张「音擎·深海访客」带的是 ZZZ / SR / 音擎；
  //          想只卖音擎卡的顾客，buys 里写 [ "音擎" ] 就行。
  // ──────────────────────────────────────────────────────────────
  // ──────────────────────────────────────────────────────────────
  //  N / R 档的「自定义物品」：写法跟上面的 sr / ur 一模一样
  // ──────────────────────────────────────────────────────────────
  //  · 留空数组 = 只用 npool / rpool 里的原版物品。
  //  · 抽取时候选表 = 原版物品 ID 各算一格 + 这里每张卡各算一格，均匀随机。
  //    想让自定义卡更容易抽到：多写几张，或者把 npool / rpool 里不想要的原版物品删掉。
  //  · 字段跟 sr / ur 完全一样：id（必填，别和别的卡重名）· name · value（面值）
  //    sprite（物品格里的图，放 Mods\ds_gacha\Textures\Items\<名字>.png）
  //    art（放大看的高清图，放 Mods\ds_gacha\Art\<名字>.png）
  //    kind（类别，会自动变成标签）· desc（描述）· tags（额外标签数组）· inspectable（能否放大）
  //    w / h（占几格，一格 16px；不写就是 2×3 = 32×48 的图）
