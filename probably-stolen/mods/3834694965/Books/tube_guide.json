    {
      "name": "Getter",
      "elements": [
        {
          "type": "text",
          "x": 28,
          "y": 74,
          "w": 258,
          "h": 14,
          "text": "2. Getter",
          "translations": {
            "ja": "2. ゲッター",
            "zh": "2. 吸气剂"
          },
          "style": "label",
          "align": "left",
          "valign": "middle",
          "fontSize": 7.5,
          "color": "#355271"
        },
        {
          "type": "text",
          "x": 28,
          "y": 90,
          "w": 258,
          "h": 26,
          "text": "The getter is the silver mirror inside the glass dome. It soaks up stray gas, and it shows how the tube has lived. A white getter means air has leaked in: the tube is dead.",
          "translations": {
            "ja": "ゲッターは、ガラスの頭の内側にある銀色の鏡です。残ったガスを吸い取り、真空管の来歴を物語ります。白いゲッターは空気が漏れた印で、その真空管は動きません。",
            "zh": "吸气剂是玻璃穹顶内侧的银色镜面，用来吸收残余气体，也记录着电子管的使用经历。吸气剂发白，说明空气漏进来了：这支管已经失效。"
          },
          "style": "body",
          "align": "left",
          "valign": "top",
          "fontSize": 5.5,
          "color": "#373541"
        },
        {
          "type": "image",
          "x": 28,
          "y": 124,
          "w": 84,
          "h": 63,
          "sprite": "tg_getter_silver",
          "fit": "stretch"
        },
        {
          "type": "text",
          "x": 120,
          "y": 124,
          "w": 170,
          "h": 63,
          "text": "Silver Getter\n(No Change)",
          "translations": {
            "ja": "銀色のゲッター\n（変化なし）",
            "zh": "银色吸气剂\n（价格不变）"
          },
          "style": "body",
          "align": "left",
          "valign": "middle",
          "fontSize": 6,
          "color": "#373541"
        },
        {
          "type": "image",
          "x": 28,
          "y": 202,
          "w": 84,
          "h": 63,
          "sprite": "tg_getter_white",
          "fit": "stretch"
        },
        {
          "type": "text",
          "x": 120,
          "y": 202,
          "w": 170,
          "h": 63,
          "text": "White Getter (Air Leak)\n(-110 Credits)",
          "translations": {
            "ja": "白いゲッター（空気漏れ）\n（-110クレジット）",
            "zh": "白色吸气剂（漏气）\n（-110信用点）"
          },
          "style": "body",
          "align": "left",
          "valign": "middle",
          "fontSize": 6,
          "color": "#373541"
        },
        {
          "type": "image",
          "x": 28,
          "y": 280,
          "w": 84,
          "h": 63,
          "sprite": "tg_getter_burnt",
          "fit": "stretch"
        },
        {
          "type": "text",
          "x": 120,
          "y": 280,
          "w": 170,
          "h": 63,
          "text": "Burnt Getter\n(-45 Credits)",
          "translations": {
            "ja": "焼けたゲッター\n（-45クレジット）",
            "zh": "烧焦的吸气剂\n（-45信用点）"
          },
          "style": "body",
          "align": "left",
          "valign": "middle",
          "fontSize": 6,
          "color": "#373541"
        }
      ],
      "template": "guide_page",
      "slots": {
        "header": "Station Trade Commission",
        "title": "Alder Vacuum Tube Appraisal Guide",
        "body": ""
      }
