    {
      "name": "Crest",
      "elements": [
        {
          "type": "text",
          "x": 28,
          "y": 74,
          "w": 258,
          "h": 14,
          "text": "6. Crest",
          "translations": {
            "ja": "6. 紋章",
            "zh": "6. 纹章"
          },
          "style": "label",
          "align": "left",
          "valign": "middle",
          "fontSize": 7.5,
          "color": "#355271"
        },
        {
          "type": "text",
          "x": 28,
          "y": 92,
          "w": 258,
          "h": 36,
          "text": "Every genuine Sunvale tin has this seal stuck on its label, to the lower right of the fruit: a round seal with a sun above a single leaf.",
          "translations": {
            "ja": "サンヴェイルの缶詰のラベルには、果実の右下に必ずこのシールが貼られています。1枚の葉の上に太陽がある、丸いシールです。",
            "zh": "每个正品桑维尔罐头的标签上，水果的右下方都贴着这个贴纸：圆形贴纸，一片叶子上方有一轮太阳。"
          },
          "style": "body",
          "align": "left",
          "valign": "top",
          "fontSize": 5.5,
          "color": "#373541"
        },
        {
          "type": "image",
          "x": 28,
          "y": 132,
          "w": 96,
          "h": 72,
          "sprite": "cg_crest_genuine",
          "fit": "stretch"
        },
        {
          "type": "text",
          "x": 28,
          "y": 205,
          "w": 116,
          "h": 12,
          "text": "Genuine",
          "translations": {
            "ja": "正規",
            "zh": "正品"
          },
          "style": "label",
          "align": "left",
          "valign": "middle",
          "fontSize": 6,
          "color": "#355271"
        },
        {
          "type": "image",
          "x": 162,
          "y": 132,
          "w": 96,
          "h": 72,
          "sprite": "cg_crest_fake_a",
          "fit": "stretch"
        },
        {
          "type": "text",
          "x": 162,
          "y": 205,
