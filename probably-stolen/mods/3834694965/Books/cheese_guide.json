          "fit": "stretch"
        },
        {
          "type": "text",
          "x": 120,
          "y": 202,
          "w": 170,
          "h": 63,
          "text": "White Mold (Good Bloom)\n(+60 Credits)",
          "translations": {
            "ja": "白カビ（良い花）\n（+60クレジット）",
            "zh": "白霉（好花）\n（+60信用点）"
