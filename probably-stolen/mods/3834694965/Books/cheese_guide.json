    {
      "name": "Cut",
      "elements": [
        {
          "type": "text",
          "x": 28,
          "y": 74,
          "w": 258,
          "h": 14,
          "text": "5. Cut",
          "translations": {
            "ja": "5. 切り欠き",
            "zh": "5. 缺口"
          },
          "style": "label",
          "align": "left",
          "valign": "middle",
          "fontSize": 7.5,
          "color": "#355271"
        },
        {
          "type": "text",
          "x": 28,
          "y": 90,
          "w": 258,
          "h": 26,
          "text": "A wheel is worth the most whole. A missing wedge shows the paste inside, with its round holes (eyes).",
          "translations": {
            "ja": "ホールは、丸ごとのときがいちばん高く売れます。欠けた所からは、中身と丸い穴（目）が見えます。",
            "zh": "整轮的奶酪最值钱。缺掉一块的地方能看到里面的奶酪体和圆孔（气孔）。"
          },
          "style": "body",
          "align": "left",
          "valign": "top",
          "fontSize": 5.5,
          "color": "#373541"
        },
        {
          "type": "image",
          "x": 28,
          "y": 124,
          "w": 84,
          "h": 63,
          "sprite": "hg_cut_whole",
          "fit": "stretch"
        },
        {
          "type": "text",
          "x": 120,
          "y": 124,
          "w": 170,
          "h": 63,
          "text": "Whole Wheel\n(No Change)",
          "translations": {
            "ja": "丸ごとのホール\n（変化なし）",
            "zh": "完整的整轮\n（价格不变）"
          },
          "style": "body",
          "align": "left",
          "valign": "middle",
          "fontSize": 6,
          "color": "#373541"
        },
        {
          "type": "image",
          "x": 28,
          "y": 202,
          "w": 84,
          "h": 63,
          "sprite": "hg_cut_eighth",
