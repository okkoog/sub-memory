      "elements": [
        {
          "type": "text",
          "x": 28,
          "y": 74,
          "w": 258,
          "h": 14,
          "text": "2. Sub-Dials and Crown",
          "translations": {
            "ja": "2. 小窓と竜頭",
            "zh": "2. 子表盘与表冠"
          },
          "style": "label",
